{
  "expo": {
    "name": "Prism",
    "slug": "prism",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/prism.svg",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.prism.rn",
      "icon": {
        "light": "./assets/prism.svg",
        "dark": "./assets/prism.svg",
        "tinted": "./assets/prism.svg"  
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "app.prism.rn",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/prism.svg",
        "monochromeImage": "./assets/prism.svg",
        "backgroundColor": "#FF4B3E"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Prism needs the camera to read incoming QR frames.",
          "microphonePermission": "Prism needs the microphone for the audio channel (phase 2).",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F1",
          "dark": {
            "backgroundColor": "#0F0F0F"
          },
          "image": "./assets/prism.svg",
          "imageWidth": 160
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f8153606-8e53-484c-9e5a-06295d84ea22"
      }
    }
  }
}
